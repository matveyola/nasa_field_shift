# Agent service configuration. Copy to .env (git-ignored) and run:
#   uv run --env-file .env python -m agent_service
# Every variable is optional in development; the values below are the defaults.

# development | test | production
AGENT_ENVIRONMENT=development
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# DEBUG | INFO | WARNING | ERROR
AGENT_LOG_LEVEL=INFO
# Comma-separated, explicit scheme://host[:port]; "*" is rejected.
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---------------------------------------------------------------- agent mode
# deterministic      M1 rule-based development agent. No LLM, no key. (alias: deterministic-dev)
# scripted-llm       Real LLM loop, tools and grounding, with a scripted fake model. No key, no cost. (free demo, CI)
# gemini             PRIMARY real model: Gemini 3.8 Flash via the official google-genai SDK. Needs GEMINI_API_KEY.
#                    Without it the service is not ready (503 llm_credentials_missing); it never falls back.
# openai             OpenAI-compatible Chat Completions endpoint. Needs AGENT_OPENAI_BASE_URL, AGENT_OPENAI_MODEL and OPENAI_API_KEY.
# anthropic          Optional: Claude via the official Anthropic SDK. Needs credentials. Costs more. Never a fallback.
AGENT_AGENT=deterministic

# Bearer token for /v1/*. Empty = no auth, which is refused when AGENT_ENVIRONMENT=production
# (production requires >= 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Wall-clock budget for one whole turn (all model calls and tools), in seconds.
AGENT_TURN_TIMEOUT_S=120
# Request body limit, in bytes.
AGENT_MAX_BODY_BYTES=262144
# true logs farmer messages; keep false outside local debugging.
AGENT_LOG_MESSAGE_TEXT=false

# ---------------------------------------------------------------- Gemini (AGENT_AGENT=gemini)
# Key from Google AI Studio (https://aistudio.google.com/apikey). Read by the google-genai SDK itself, never by this
# service; server-side only: never in frontend code, VITE_* variables, screenshots or logs. (GOOGLE_API_KEY wins if both are set.)
# GEMINI_API_KEY=
AGENT_GEMINI_MODEL=gemini-3.8-flash
# low (default, economical) | medium (harder multi-tool turns) | high (opt-in). "minimal" is not supported by this model.
AGENT_GEMINI_THINKING_LEVEL=low
# Optional cost estimate in the turn usage log (USD per million tokens; thinking is billed as output). Time-sensitive:
# check https://ai.google.dev/gemini-api/docs/pricing (2026-11-07: 0.75 / 3.75 through 2026-12-31, then 1.50 / 7.50).
AGENT_LLM_PRICE_INPUT_USD_PER_MTOK=
AGENT_LLM_PRICE_OUTPUT_USD_PER_MTOK=
# Input the provider served from its cache (Gemini 3.8 Flash on 2026-11-12: 0.075 through 2026-12-31, then 0.15).
# Unset = cached input is priced like any input.
AGENT_LLM_PRICE_CACHED_INPUT_USD_PER_MTOK=

# ---------------------------------------------------------------- OpenAI-compatible (AGENT_AGENT=openai)
# Explicit HTTPS API root (or local HTTP / host.docker.internal) and exact model ID. Read OPENAI_API_KEY from server env.
# OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_MODEL=
# max_completion_tokens (default) | max_tokens
AGENT_OPENAI_TOKEN_LIMIT_FIELD=max_completion_tokens
# none | minimal | low | medium | high | xhigh | max (set none for gpt-6-luna with Chat Completions tools; empty = provider default)
AGENT_OPENAI_REASONING_EFFORT=

# ---------------------------------------------------------------- LLM loop limits (scripted-llm, gemini, openai, anthropic)
# anthropic only: credentials from the SDK (ANTHROPIC_API_KEY=sk-ant-... or an `ant` CLI profile), model and effort.
AGENT_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (anthropic only)
AGENT_LLM_EFFORT=medium
# Per model call (on Gemini this includes thinking tokens).
AGENT_LLM_MAX_OUTPUT_TOKENS=4096
# Model calls per turn (grounding repairs included) and tool executions per turn.
AGENT_LLM_MAX_ROUNDS=6
AGENT_LLM_MAX_TOOL_CALLS=12
AGENT_LLM_MAX_TOOL_CALLS_PER_ROUND=6
# Size budget for system prompt + per-turn context, in characters (oldest history is dropped first).
AGENT_LLM_MAX_CONTEXT_CHARS=60000
# SDK retries for 408/429/5xx/connection errors (rate limits included), and per-call timeout in seconds.
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_REQUEST_TIMEOUT_S=60
AGENT_LLM_TOOL_TIMEOUT_S=5
# Grounding rewrites before unsupported sentences are removed.
AGENT_LLM_MAX_REPAIRS=1
# anthropic only: server-side refusal fallback (beta server-side-fallback-2026-07-01, fallbacks="default").
AGENT_LLM_REFUSAL_FALLBACK=true
# anthropic only: strict tool schemas; arguments are re-validated on the server either way.
AGENT_LLM_STRICT_TOOLS=true

# ---------------------------------------------------------------- knowledge base (search_knowledge, LLM modes)
# Build it first (README › Knowledge base). Modes:
#   off | lexical (BM25 only, no model) | dense | hybrid (BM25 + bge-m3, RRF) | hybrid_rerank (+ bge-reranker-v2-m3)
# A mode that cannot load its models falls back to a lower one and /health/ready says so.
AGENT_RAG_MODE=lexical
# Writable data defaults to the user application-data directory. Use absolute paths.
# AGENT_DATA_DIR=/absolute/path/to/field-shift-agent
# AGENT_RAG_INDEX_PATH=/absolute/path/to/knowledge/index/knowledge.sqlite
# Hugging Face cache folder holding the pinned model revisions (empty = default ~/.cache/huggingface).
AGENT_RAG_MODEL_CACHE=
# float32 | bfloat16 (halves reranker memory; the embedder dtype is fixed by the index).
AGENT_RAG_RERANKER_DTYPE=float32
# Per search_knowledge call, in seconds (CPU reranking is slow: see README for measured latency).
AGENT_RAG_TIMEOUT_S=20
# true: /health/ready and startup fail when the index is missing or stale.
AGENT_RAG_REQUIRED=false

# ---------------------------------------------------------------- weather forecast (agent_service/weather.py)
# off (default; no network in tests) | open-meteo: real forecast for the field's centre, no key. Free for
# non-commercial use, data CC BY 4.0 (the source name is shown with every value): https://open-meteo.com/en/terms
AGENT_WEATHER_PROVIDER=off
# AGENT_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# ---------------------------------------------------------------- geo and simulation services (M5, proposed contract v0.1)
# off (default): not connected. fixture: M0 synthetic data in process (development only; refused in production).
# http: the URL below. For the local contract stub run `uv run python -m integration_stub --port 8100`.
# The stub and fixtures are NOT member 1's or member 2's services: every value they return is synthetic.
AGENT_GEO_PROVIDER=off
AGENT_GEO_URL=
AGENT_SIM_PROVIDER=off
AGENT_SIM_URL=
# Example for the stub:
#   AGENT_GEO_PROVIDER=http
#   AGENT_GEO_URL=http://127.0.0.1:8100/geo
#   AGENT_SIM_PROVIDER=http
#   AGENT_SIM_URL=http://127.0.0.1:8100/sim
AGENT_INTEGRATION_TIMEOUT_S=8
AGENT_SIM_TIMEOUT_S=30
AGENT_INTEGRATION_MAX_BYTES=2000000
# Server-to-server bearer token for the geo / simulation services. Keep it in .env (git-ignored); never in frontend code.
AGENT_INTEGRATION_TOKEN=
# M6B per-request context attestation (replaces the removed AGENT_CONTEXT_ATTESTED, which now stops startup).
# HMAC key shared ONLY by the host backend (BFF) and this service; >= 32 chars, different from AGENT_API_KEY.
# The BFF signs each request (principal, field_id, revision, body hash, expiry): docs/M6B_TEAM_ONBOARDING.md.
# Without a valid attestation, live/cached values in requests are labelled unverified and cannot back live claims.
AGENT_CONTEXT_SIGNING_KEY=
# true: refuse (403) every request without a valid attestation. Required in production.
AGENT_REQUIRE_CONTEXT_ATTESTATION=false
# hybrid_rerank only: how many fused candidates the cross-encoder re-scores. Reranking 20 took a median
# 33.5 s per query on a 6-core laptop CPU (over the timeout above): use hybrid on CPU, rerank on GPU.
AGENT_RAG_RERANK_TOP=20
