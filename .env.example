# Local Compose defaults. The browser port is bound to loopback.
WEB_PORT=8080
# Local is an explicit trusted-device mode. Use team before exposing the application.
FIELD_SHIFT_ENVIRONMENT=development
FIELD_SHIFT_ACCESS_MODE=local
# Production requires HTTPS, team mode, secure cookies and the exact public origin.
FIELD_SHIFT_SECURE_COOKIE=0
FIELD_SHIFT_PUBLIC_ORIGIN=
# One-time first-administrator setup, generate with python -c "import secrets; print(secrets.token_urlsafe(32))".
# Remove after creating the first admin. Never use a password or commit this token.
FIELD_SHIFT_BOOTSTRAP_TOKEN=
POSTGRES_USER=field_shift
POSTGRES_DB=field_shift
POSTGRES_PASSWORD=field_shift_local
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=7
FIELD_SHIFT_BACKUP_DIR=./backups
REDIS_MAX_MEMORY=256mb
JOB_TASK_TIME_LIMIT_SECONDS=120
JOB_LEASE_GRACE_SECONDS=15
JOB_POLL_SECONDS=2
JOB_DISPATCH_RETRY_SECONDS=15
WORKER_STOP_GRACE_PERIOD=150s
# Check for a new archived soil moisture day every hour.
MOISTURE_REFRESH_INTERVAL_SECONDS=3600
# Enable daily ECMWF IFS forecasts through the same durable geo_ml queue.
MOISTURE_FORECAST_REFRESH=1
# Enable daily five-day root-zone forecasts in the simulation queue.
WATER_FORECAST_REFRESH=1
# Enable scheduled Sentinel-2 vegetation refresh in the geo_ml queue.
VEGETATION_REFRESH=1
# Reuse the same validated daily IFS inputs in both workers.
IFS_FORECAST_CACHE=1
# Set to 1 only in a deployment that should expose and refresh the experimental model.
MOISTURE_ENABLE_EXPERIMENTAL=0
MOISTURE_MODEL_PREVIEW=v1
# Expose the rotation trial model for controlled research preview.
ROTATION_YIELD_ENABLE_EXPERIMENTAL=0
# Optional key for the Open-Meteo customer archive endpoint.
OPEN_METEO_API_KEY=
# The optional agent profile uses .env.agent, generated by python infra/configure-agent.py.
# Only the API and private agent service receive the internal credentials.
FIELD_SHIFT_AGENT_URL=
FIELD_SHIFT_AGENT_API_KEY=
FIELD_SHIFT_AGENT_SIGNING_KEY=
# scripted-llm runs the agent loop with a local scripted model.
# Set gemini and supply a server-side key to enable the paid provider.
FIELD_SHIFT_AGENT_MODE=scripted-llm
FIELD_SHIFT_AGENT_GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# OpenAI-compatible Chat Completions. Set FIELD_SHIFT_AGENT_MODE=openai to use these.
# Use the provider's API base URL and exact model ID, such as gpt-luna on your gateway.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_TOKEN_LIMIT_FIELD=max_completion_tokens
# Set none for gpt-6-luna with Chat Completions tools. Leave blank to use the provider default.
OPENAI_REASONING_EFFORT=
