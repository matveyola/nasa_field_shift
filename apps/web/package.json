{
  "name": "field-shift-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts tests/planning/*.test.ts tests/strategies/*.test.ts tests/analytics/*.test.ts",
    "preview": "vite preview",
    "test:planning": "node ../../services/agent/frontend/node_modules/@playwright/test/cli.js test --config playwright.planning.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@heroicons/react": "2.2.0",
    "ajv-formats": "^3.0.1",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "proj4": "^2.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
