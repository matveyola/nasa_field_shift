{
  "$defs": {
    "AcceptanceCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^G[0-9]{2}$",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "case_kind": {
          "const": "synthetic_contract",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/CaseLocation"
        },
        "production_system": {
          "const": "outdoor",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "expected_invariants": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "agronomist_reviewed": {
          "const": false,
          "type": "boolean"
        },
        "paired_with": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "case_kind",
        "location",
        "production_system",
        "inputs",
        "expected_invariants",
        "agronomist_reviewed"
      ],
      "title": "AcceptanceCase",
      "type": "object"
    },
    "CaseLocation": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "CaseLocation",
      "type": "object"
    },
    "JsonValue": {},
    "WeatherRecipe": {
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "enum": [
            "constant_daily",
            "constant_daily_on_window"
          ],
          "type": "string"
        },
        "tmin_c": {
          "maximum": 65,
          "minimum": -100,
          "type": "number"
        },
        "tmax_c": {
          "maximum": 65,
          "minimum": -100,
          "type": "number"
        },
        "liquid_rain_mm": {
          "maximum": 3000,
          "minimum": 0,
          "type": "number"
        },
        "et0_mm": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "shortwave_mj_m2": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "soil_frozen": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "window": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "format": "date",
                  "type": "string"
                }
              ],
              "type": "array",
              "tsType": "[string, string]"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "recipe",
        "tmin_c",
        "tmax_c",
        "liquid_rain_mm",
        "et0_mm",
        "shortwave_mj_m2"
      ],
      "title": "WeatherRecipe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "planning-acceptance-v1",
      "type": "string"
    },
    "created_at": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "const": "test_specification_not_executed",
      "type": "string"
    },
    "scope": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "warning": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "required_fixture_expansion": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "weather_profiles": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
          "$ref": "#/$defs/WeatherRecipe"
        }
      },
      "type": "object"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/AcceptanceCase"
      },
      "maxItems": 24,
      "minItems": 24,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "status",
    "scope",
    "warning",
    "required_fixture_expansion",
    "weather_profiles",
    "cases"
  ],
  "title": "AcceptancePack",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from apps/api/src/field_shift/contracts/planning_v1. Python validators additionally enforce cross-field semantics; see README.md."
}
